# Copy to .env and fill in. Never commit .env.

# --- SQL Server (docker compose + API) ---
# Must be 8+ chars with upper, lower, digit and symbol, or SQL Server won't start.
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=1434
DB_NAME=sage
DB_USER=sa
# Use "ODBC Driver 17 for SQL Server" if 18 isn't installed
ODBC_DRIVER=ODBC Driver 18 for SQL Server

# --- API ---
ENVIRONMENT=development
JWT_SECRET=
CORS_ORIGINS=["http://localhost:5173"]

# --- AI ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Web (Vite) ---
VITE_API_URL=http://localhost:8000
